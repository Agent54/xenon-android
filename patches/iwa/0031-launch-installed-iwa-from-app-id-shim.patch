+        sourceIntent.putExtra(WebappConstants.EXTRA_NAME, name);
+        sourceIntent.putExtra(WebappConstants.EXTRA_SHORT_NAME, name);
+        sourceIntent.putExtra(WebappConstants.EXTRA_DISPLAY_MODE, DisplayMode.STANDALONE);
+        sourceIntent.putExtra(WebappConstants.EXTRA_SOURCE, ShortcutSource.UNKNOWN);
+
+        LaunchData launchData =
+                new LaunchData(
+                        appId,
+                        url,
+                        /* webApkPackageName= */ null,
+                        /* isSplashProvidedByWebApk= */ false);
+        launchData.isIconTrusted = true;
+        Intent launchIntent = createIntentToLaunchForWebapp(sourceIntent, launchData);
+        launchIntent.putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId);
+        return IntentUtils.safeStartActivity(
+                ContextUtils.getApplicationContext(), launchIntent);
+    }
