+package org.chromium.chrome.browser.webapps;
+
+import android.app.Activity;
+import android.content.Intent;
+import android.os.Bundle;
+import android.os.Handler;
+import android.os.Looper;
+import android.text.TextUtils;
+
+import org.jni_zero.CalledByNative;
+import org.jni_zero.JniType;
+import org.jni_zero.NativeMethods;
+
+import org.chromium.base.IntentUtils;
+import org.chromium.base.Log;
+import org.chromium.build.annotations.NullMarked;
+import org.chromium.build.annotations.Nullable;
+import org.chromium.chrome.browser.firstrun.FirstRunStatus;
+import org.chromium.chrome.browser.init.ChromeBrowserInitializer;
+import org.chromium.chrome.browser.profiles.Profile;
+import org.chromium.chrome.browser.profiles.ProfileManager;
+
+/** App-owned entry point for an already installed isolated web app. */
+@NullMarked
+public class IwaLauncherActivity extends Activity {
+    private static final String TAG = "IwaLauncher";
+    private static final long REGISTRY_TIMEOUT_MS = 15000;
+
+    public static final String ACTION_LAUNCH_IWA = "org.agent54.xenon.iwa.LAUNCH";
+    public static final String EXTRA_APP_ID = "org.agent54.xenon.iwa.APP_ID";
+
+    private final Handler mHandler = new Handler(Looper.getMainLooper());
+    private final Runnable mTimeout =
+            () -> {
+                Log.e(TAG, "Installed IWA registry did not become ready");
+                finish();
+            };
+
+    @Override
+    protected void onCreate(@Nullable Bundle savedInstanceState) {
+        super.onCreate(savedInstanceState);
+        Intent intent = getIntent();
+        if (!ACTION_LAUNCH_IWA.equals(intent.getAction())
+                || TextUtils.isEmpty(IntentUtils.safeGetStringExtra(intent, EXTRA_APP_ID))) {
+            Log.e(TAG, "IWA launch rejected: invalid request");
+            finish();
+            return;
+        }
+        if (!FirstRunStatus.getFirstRunFlowComplete()) {
+            Log.i(TAG, "IWA launch requires completion of browser first run");
+            finish();
+            return;
+        }
+
+        ChromeBrowserInitializer.getInstance().handleSynchronousStartup();
+        Profile profile = ProfileManager.getLastUsedRegularProfile();
+        if (profile.isOffTheRecord()) {
+            finish();
+            return;
+        }
+        String appId = IntentUtils.safeGetStringExtra(intent, EXTRA_APP_ID);
+        if (appId == null) {
+            finish();
+            return;
+        }
+        mHandler.postDelayed(mTimeout, REGISTRY_TIMEOUT_MS);
+        IwaLauncherActivityJni.get().requestLaunch(profile, appId, this);
+    }
+
+    @CalledByNative
+    private void onResolved(
+            @JniType("std::string") String appId,
+            @JniType("std::string") String startUrl,
+            @JniType("std::string") String scope,
+            @JniType("std::string") String name) {
+        mHandler.removeCallbacks(mTimeout);
+        if (!isFinishing() && !isDestroyed()) {
+            if (!WebappLauncherActivity.launchInstalledIwa(appId, startUrl, scope, name)) {
+                Log.e(TAG, "Failed to start the installed IWA activity");
+            }
+        }
+        finish();
+    }
+
+    @CalledByNative
+    private void onNotInstalled() {
+        mHandler.removeCallbacks(mTimeout);
+        Log.e(TAG, "IWA launch rejected: app is not installed or launchable");
+        finish();
+    }
+
+    @Override
+    protected void onDestroy() {
+        mHandler.removeCallbacks(mTimeout);
+        super.onDestroy();
+    }
+
+    @NativeMethods
+    interface Natives {
+        void requestLaunch(
+                @JniType("Profile*") Profile profile,
+                @JniType("std::string") String appId,
+                IwaLauncherActivity activity);
+    }
+}
