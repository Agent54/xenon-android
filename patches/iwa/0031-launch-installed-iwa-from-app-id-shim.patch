+++ b/chrome/browser/web_applications/android_iwa_launcher.cc
@@ -0,0 +1,99 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include <string>
+#include <utility>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/android/jni_weak_ref.h"
+#include "base/android/scoped_java_ref.h"
+#include "base/functional/bind.h"
+#include "base/memory/weak_ptr.h"
+#include "chrome/browser/profiles/profile.h"
+#include "chrome/browser/web_applications/isolated_web_apps/isolated_web_app_url_info.h"
+#include "chrome/browser/web_applications/web_app_filter.h"
+#include "chrome/browser/web_applications/web_app_provider.h"
+#include "chrome/browser/web_applications/web_app_registrar.h"
+#include "components/webapps/isolated_web_apps/scheme.h"
+#include "content/public/browser/isolated_web_apps_policy.h"
+#include "url/origin.h"
+
+// Must come after headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/IwaLauncherActivity_jni.h"
+
+namespace {
+
+using web_app::IsolatedWebAppUrlInfo;
+using web_app::WebAppFilter;
+using web_app::WebAppProvider;
+using web_app::WebAppRegistrar;
+
+void ResolveInstalledIwa(
+    base::WeakPtr<WebAppProvider> provider,
+    std::string app_id,
+    JavaObjectWeakGlobalRef java_activity) {
+  JNIEnv* env = base::android::AttachCurrentThread();
+  auto local_activity = java_activity.get(env);
+  if (!local_activity) {
+    return;
+  }
+  if (!provider || !provider->is_registry_ready()) {
+    Java_IwaLauncherActivity_onNotInstalled(env, local_activity);
+    return;
+  }
+
+  const WebAppRegistrar& registrar = provider->registrar_unsafe();
+  if (!registrar.AppMatches(app_id, WebAppFilter::IsIsolatedApp()) ||
+      !registrar.AppMatches(app_id, WebAppFilter::InstalledInChrome())) {
+    Java_IwaLauncherActivity_onNotInstalled(env, local_activity);
+    return;
+  }
+
+  const GURL& start_url = registrar.GetAppStartUrl(app_id);
+  const GURL scope = registrar.GetAppScope(app_id);
+  const auto url_info = IsolatedWebAppUrlInfo::Create(start_url);
+  if (!url_info.has_value() || url_info->app_id() != app_id ||
+      !scope.SchemeIs(webapps::kIsolatedAppScheme) ||
+      url::Origin::Create(scope) != url::Origin::Create(start_url)) {
+    Java_IwaLauncherActivity_onNotInstalled(env, local_activity);
+    return;
+  }
+
+  Java_IwaLauncherActivity_onResolved(
+      env, local_activity, app_id, start_url.spec(), scope.spec(),
+      registrar.GetAppShortName(app_id));
+}
+
+}  // namespace
+
+static void JNI_IwaLauncherActivity_RequestLaunch(
+    JNIEnv* env,
+    Profile* profile,
+    const std::string& app_id,
+    const base::android::JavaRef<
+        org::chromium::chrome::browser::webapps::JIwaLauncherActivity>&
+        java_activity) {
+  if (!profile || profile->IsOffTheRecord() ||
+      !content::AreIsolatedWebAppsEnabled(profile)) {
+    Java_IwaLauncherActivity_onNotInstalled(env, java_activity);
+    return;
+  }
+
+  web_app::WebAppProvider* provider =
+      web_app::WebAppProvider::GetForWebApps(profile);
+  if (!provider) {
+    Java_IwaLauncherActivity_onNotInstalled(env, java_activity);
+    return;
+  }
+
+  provider->on_registry_ready().Post(
+      FROM_HERE,
+      base::BindOnce(&ResolveInstalledIwa, provider->AsWeakPtr(), app_id,
+                     JavaObjectWeakGlobalRef(
+                         env, base::android::JavaRef<jobject>::CreateLeaky(
+                                  env, java_activity.obj()))));
+}
+
+DEFINE_JNI(IwaLauncherActivity)
