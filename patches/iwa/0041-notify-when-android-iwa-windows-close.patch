+    /** Waits for pending handoffs, recreation reservations, and live activities to clear. */
+    @CalledByNative
+    static String notifyOnAllIwaWindowsClosed(
+            @JniType("std::string") String appId, JniOnceRunnable callback) {
+        ThreadUtils.assertOnUiThread();
+        ensureIwaWindowListener();
+        String waiterId = UUID.randomUUID().toString();
+        sIwaCloseWaiters.put(waiterId, new IwaCloseWaiter(appId, callback));
+        maybeNotifyIwaWindowsClosed();
+        return waiterId;
+    }
+
+    /** Native UI-manager shutdown must release callbacks that never ran. */
+    @CalledByNative
+    static void cancelIwaWindowsClosedCallback(@JniType("std::string") String waiterId) {
+        ThreadUtils.assertOnUiThread();
+        IwaCloseWaiter waiter = sIwaCloseWaiters.remove(waiterId);
+        maybeUnregisterIwaWindowListener();
+        if (waiter != null) waiter.callback.destroy();
+    }
+
+    private static void maybeNotifyIwaWindowsClosed() {
+        ThreadUtils.assertOnUiThread();
+        if (sIwaCloseWaiters.isEmpty()) {
+            maybeUnregisterIwaWindowListener();
+            return;
+        }
+        List<String> waiterIds = new ArrayList<>(sIwaCloseWaiters.keySet());
+        for (String waiterId : waiterIds) {
+            IwaCloseWaiter waiter = sIwaCloseWaiters.get(waiterId);
+            if (waiter == null || getNumIwaWindowsForApp(waiter.appId) != 0) continue;
+            sIwaCloseWaiters.remove(waiterId);
+            maybeUnregisterIwaWindowListener();
+            waiter.callback.run();
+        }
+    }
