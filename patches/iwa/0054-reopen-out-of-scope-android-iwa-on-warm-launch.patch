+    static boolean shouldForceIwaNavigationForLaunch(
+            @Nullable Intent currentIntent,
+            @Nullable Intent incomingIntent,
+            @Nullable String currentUrl) {
+        if (currentIntent == null || incomingIntent == null || TextUtils.isEmpty(currentUrl)) {
+            return false;
+        }
+        String appId = IntentUtils.safeGetStringExtra(incomingIntent, IwaLauncherActivity.EXTRA_APP_ID);
+        if (appId == null
+                || !appId.equals(
+                        IntentUtils.safeGetStringExtra(
+                                currentIntent, IwaLauncherActivity.EXTRA_APP_ID))) {
+            return false;
+        }
+        String token = IntentUtils.safeGetStringExtra(incomingIntent, EXTRA_IWA_LAUNCH_TOKEN);
+        IwaLaunchReservation reservation = token == null ? null : sPendingIwaLaunches.get(token);
+        if (reservation == null || !reservation.handedOff || !appId.equals(reservation.appId)) {
+            return false;
+        }
+        String scope = IntentUtils.safeGetStringExtra(incomingIntent, WebappConstants.EXTRA_SCOPE);
+        String startUrl = IntentUtils.safeGetStringExtra(incomingIntent, WebappConstants.EXTRA_URL);
+        return !TextUtils.isEmpty(scope)
+                && !TextUtils.isEmpty(startUrl)
+                && UrlUtilities.isUrlWithinScope(startUrl, scope)
+                && !UrlUtilities.isUrlWithinScope(currentUrl, scope);
+    }
+
     @Override
     public void onNewIntent(Intent intent) {
+        Tab tab = getActivityTab();
+        boolean reopen =
+                shouldForceIwaNavigationForLaunch(
+                        getIntent(), intent, tab == null ? null : tab.getUrl().getSpec());
         super.onNewIntent(intent);
+        if (reopen) {
+            // The generic webapp handler rejects isolated-app:// intent URLs.
+            // Navigate only a registry-verified warm launch that left scope.
+            String startUrl = IntentUtils.safeGetStringExtra(intent, WebappConstants.EXTRA_URL);
+            if (startUrl != null) {
+                getCustomTabActivityNavigationController()
+                        .navigate(new LoadUrlParams(startUrl), intent);
+            }
+        }
         consumeIwaLaunch(this, intent);
     }
 
