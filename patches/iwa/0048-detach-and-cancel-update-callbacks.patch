+TEST(IsolatedWebAppUpdateCallbackCoordinatorTest,
+     SynchronousStartCompletionMayDestroyOwner) {
+  base::test::TaskEnvironment task_environment;
+  std::unique_ptr<IsolatedWebAppUpdateCallbackCoordinator> coordinator;
+  coordinator = std::make_unique<IsolatedWebAppUpdateCallbackCoordinator>(
+      base::BindRepeating([](const webapps::AppId&) { return true; }),
+      base::BindRepeating(
+          [](std::unique_ptr<IsolatedWebAppUpdateCallbackCoordinator>* owner,
+             const webapps::AppId& app_id) {
+            (*owner)->Complete(app_id, base::ok());
+          },
+          &coordinator));
+
+  int calls = 0;
+  coordinator->PrioritizeAndWait(
+      "app",
+      base::BindOnce(
+          [](std::unique_ptr<IsolatedWebAppUpdateCallbackCoordinator>* owner,
+             int* count, IsolatedWebAppApplyUpdateCommandResult result) {
+            EXPECT_TRUE(result.has_value());
+            ++*count;
+            owner->reset();
+          },
+          &coordinator, &calls));
+  EXPECT_EQ(calls, 1);
+  EXPECT_FALSE(coordinator);
+}
+
+TEST(IsolatedWebAppUpdateCallbackCoordinatorTest,
+     DetachedBatchExcludesObserverReentrantRegistration) {
+  base::test::TaskEnvironment task_environment;
+  IsolatedWebAppUpdateCallbackCoordinator coordinator(
+      base::BindRepeating([](const webapps::AppId&) { return true; }),
+      base::BindRepeating([](const webapps::AppId&) {}));
+  int old_calls = 0;
+  int new_calls = 0;
+  coordinator.PrioritizeAndWait(
+      "app",
+      base::BindOnce(
+          [](int* count, IsolatedWebAppApplyUpdateCommandResult) { ++*count; },
+          &old_calls));
+
+  auto completed_batch = coordinator.TakeBatch("app");
+  coordinator.PrioritizeAndWait(
+      "app",
+      base::BindOnce(
+          [](int* count, IsolatedWebAppApplyUpdateCommandResult) { ++*count; },
+          &new_calls));
+  coordinator.DispatchBatch(std::move(completed_batch), base::ok());
+  EXPECT_EQ(old_calls, 1);
+  EXPECT_EQ(new_calls, 0);
+  coordinator.Complete("app", base::ok());
+  EXPECT_EQ(new_calls, 1);
+}
+
+TEST(IsolatedWebAppUpdateCallbackCoordinatorTest,
+     ShutdownCancelsDetachedAndPendingCallbacks) {
+  base::test::TaskEnvironment task_environment;
+  IsolatedWebAppUpdateCallbackCoordinator coordinator(
+      base::BindRepeating([](const webapps::AppId&) { return true; }),
+      base::BindRepeating([](const webapps::AppId&) {}));
+  int calls = 0;
+  for (const char* app_id : {"detached", "pending"}) {
+    coordinator.PrioritizeAndWait(
+        app_id,
+        base::BindOnce([](int* count,
+                          IsolatedWebAppApplyUpdateCommandResult) { ++*count; },
+                       &calls));
+  }
+  auto detached = coordinator.TakeBatch("detached");
+  coordinator.Shutdown();
+  coordinator.DispatchBatch(std::move(detached), base::ok());
+  coordinator.Complete("pending", base::ok());
+  EXPECT_EQ(calls, 0);
+}
+
+TEST(IsolatedWebAppUpdateCallbackCoordinatorTest,
+     ShutdownDuringDispatchCancelsRemainingCallbacks) {
+  base::test::TaskEnvironment task_environment;
+  IsolatedWebAppUpdateCallbackCoordinator coordinator(
+      base::BindRepeating([](const webapps::AppId&) { return true; }),
+      base::BindRepeating([](const webapps::AppId&) {}));
+  int remaining_calls = 0;
+  coordinator.PrioritizeAndWait(
+      "app",
+      base::BindOnce(
+          [](IsolatedWebAppUpdateCallbackCoordinator* owner,
+             IsolatedWebAppApplyUpdateCommandResult) { owner->Shutdown(); },
+          &coordinator));
+  coordinator.PrioritizeAndWait(
+      "app",
+      base::BindOnce(
+          [](int* count, IsolatedWebAppApplyUpdateCommandResult) { ++*count; },
+          &remaining_calls));
+
+  coordinator.Complete("app", base::ok());
+  EXPECT_EQ(remaining_calls, 0);
+}
+
+TEST(IsolatedWebAppUpdateCallbackCoordinatorTest,
+     RegistrationAfterShutdownPostsErrorWithoutStarting) {
+  base::test::TaskEnvironment task_environment;
+  int starts = 0;
+  IsolatedWebAppUpdateCallbackCoordinator coordinator(
+      base::BindRepeating([](const webapps::AppId&) { return true; }),
+      base::BindRepeating([](int* count, const webapps::AppId&) { ++*count; },
+                          &starts));
+  coordinator.Shutdown();
+
+  int errors = 0;
+  coordinator.PrioritizeAndWait(
+      "app", base::BindOnce(
+                 [](int* count, IsolatedWebAppApplyUpdateCommandResult result) {
+                   EXPECT_FALSE(result.has_value());
