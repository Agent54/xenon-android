+    @Test
+    public void iwaWindowCountTracksActivityUntilDestroyed() {
+        String appId = "idgjjoiemckfcohgjoaafbninphmambh";
+        TestWebappActivity iwaActivity = new TestWebappActivity();
+        iwaActivity.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId));
+        TestWebappActivity secondIwaActivity = new TestWebappActivity();
+        secondIwaActivity.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId));
+        TestWebappActivity otherIwaActivity = new TestWebappActivity();
+        otherIwaActivity.setIntent(
+                new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, "another-app"));
+        TestWebappActivity ordinaryWebapp = new TestWebappActivity();
+        ordinaryWebapp.setIntent(new Intent());
+
+        try {
+            ApplicationStatus.onStateChangeForTesting(iwaActivity, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(secondIwaActivity, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(otherIwaActivity, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(ordinaryWebapp, ActivityState.CREATED);
+            assertEquals(2, WebappActivity.getNumIwaWindowsForApp(appId));
+            assertEquals(1, WebappActivity.getNumIwaWindowsForApp("another-app"));
+
+            ApplicationStatus.onStateChangeForTesting(iwaActivity, ActivityState.STARTED);
+            ApplicationStatus.onStateChangeForTesting(iwaActivity, ActivityState.STOPPED);
+            assertEquals(2, WebappActivity.getNumIwaWindowsForApp(appId));
+        } finally {
+            ApplicationStatus.onStateChangeForTesting(iwaActivity, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(secondIwaActivity, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(otherIwaActivity, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(ordinaryWebapp, ActivityState.DESTROYED);
+        }
+        assertEquals(0, WebappActivity.getNumIwaWindowsForApp(appId));
+    }
+
