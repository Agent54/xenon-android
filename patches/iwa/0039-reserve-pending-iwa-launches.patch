+    @Test
+    public void pendingIwaLaunchCountsUntilActivityAcceptsIt() {
+        String appId = "idgjjoiemckfcohgjoaafbninphmambh";
+        String token = WebappActivity.reserveIwaLaunch(appId);
+        assertEquals(1, WebappActivity.getNumIwaWindowsForApp(appId));
+        assertFalse(WebappActivity.isIwaLaunchResolving("stale-process-token", appId));
+        assertTrue(WebappActivity.markIwaLaunchHandedOff(token, appId));
+        assertFalse(WebappActivity.isIwaLaunchResolving(token, appId));
+        TestWebappActivity wrongApp = new TestWebappActivity();
+        wrongApp.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, "other")
+                .putExtra(WebappActivity.EXTRA_IWA_LAUNCH_TOKEN, token));
+        ApplicationStatus.onStateChangeForTesting(wrongApp, ActivityState.CREATED);
+        try {
+            assertEquals(1, WebappActivity.getNumIwaWindowsForApp(appId));
+        } finally {
+            ApplicationStatus.onStateChangeForTesting(wrongApp, ActivityState.DESTROYED);
+        }
+
+        TestWebappActivity activity = new TestWebappActivity();
+        activity.setIntent(
+                new Intent()
+                        .putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId)
+                        .putExtra(WebappActivity.EXTRA_IWA_LAUNCH_TOKEN, token));
+        try {
+            ApplicationStatus.onStateChangeForTesting(activity, ActivityState.CREATED);
+            assertEquals(1, WebappActivity.getNumIwaWindowsForApp(appId));
+            ApplicationStatus.onStateChangeForTesting(activity, ActivityState.STOPPED);
+            assertEquals(1, WebappActivity.getNumIwaWindowsForApp(appId));
+        } finally {
+            ApplicationStatus.onStateChangeForTesting(activity, ActivityState.DESTROYED);
+            WebappActivity.releaseIwaLaunch(token);
+        }
+        assertEquals(0, WebappActivity.getNumIwaWindowsForApp(appId));
+    }
+
+    @Test
+    public void concurrentIwaReservationsHaveIndependentHandoffOwnership() {
+        String appId = "idgjjoiemckfcohgjoaafbninphmambh";
+        String first = WebappActivity.reserveIwaLaunch(appId);
+        String second = WebappActivity.reserveIwaLaunch(appId);
+        try {
+            assertFalse(first.equals(second));
+            assertEquals(2, WebappActivity.getNumIwaWindowsForApp(appId));
+            assertFalse(WebappActivity.markIwaLaunchHandedOff(first, "wrong-app"));
+            assertTrue(WebappActivity.markIwaLaunchHandedOff(first, appId));
+            assertFalse(WebappActivity.markIwaLaunchHandedOff(first, appId));
+            WebappActivity.releaseResolvingIwaLaunch(first);
+            assertEquals(2, WebappActivity.getNumIwaWindowsForApp(appId));
+            WebappActivity.releaseResolvingIwaLaunch(second);
+            assertEquals(1, WebappActivity.getNumIwaWindowsForApp(appId));
+        } finally {
+            WebappActivity.releaseIwaLaunch(first);
+            WebappActivity.releaseIwaLaunch(second);
+        }
+        assertEquals(0, WebappActivity.getNumIwaWindowsForApp(appId));
+    }
+
     @Test
