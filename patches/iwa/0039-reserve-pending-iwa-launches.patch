+    /** Holds a launch across registry resolution and Android activity handoff. */
+    static String reserveIwaLaunch(String appId) {
+        ThreadUtils.assertOnUiThread();
+        if (sPendingIwaLaunches.isEmpty()) {
+            ApplicationStatus.registerStateListenerForAllActivities(sIwaLaunchListener);
+        }
+        String token = UUID.randomUUID().toString();
+        sPendingIwaLaunches.put(token, new IwaLaunchReservation(appId));
+        return token;
+    }
+
+    static boolean isIwaLaunchResolving(String token, String appId) {
+        ThreadUtils.assertOnUiThread();
+        IwaLaunchReservation reservation = sPendingIwaLaunches.get(token);
+        return reservation != null && appId.equals(reservation.appId) && !reservation.handedOff;
+    }
+
+    static boolean markIwaLaunchHandedOff(String token, String appId) {
+        ThreadUtils.assertOnUiThread();
+        IwaLaunchReservation reservation = sPendingIwaLaunches.get(token);
+        if (reservation == null || !appId.equals(reservation.appId) || reservation.handedOff) {
+            return false;
+        }
+        reservation.handedOff = true;
+        return true;
+    }
+
+    static void releaseResolvingIwaLaunch(String token) {
+        ThreadUtils.assertOnUiThread();
+        IwaLaunchReservation reservation = sPendingIwaLaunches.get(token);
+        if (reservation != null && !reservation.handedOff) releaseIwaLaunch(token);
+    }
+
+    static void releaseIwaLaunch(String token) {
+        ThreadUtils.assertOnUiThread();
+        if (sPendingIwaLaunches.remove(token) != null && sPendingIwaLaunches.isEmpty()) {
+            ApplicationStatus.unregisterActivityStateListener(sIwaLaunchListener);
+        }
+    }
+
+    private static void consumeIwaLaunch(Activity activity, Intent incoming) {
+        if (incoming == null || activity.getIntent() == null) return;
+        String appId = IntentUtils.safeGetStringExtra(incoming, IwaLauncherActivity.EXTRA_APP_ID);
+        if (appId == null
+                || !appId.equals(
+                        IntentUtils.safeGetStringExtra(
+                                activity.getIntent(), IwaLauncherActivity.EXTRA_APP_ID))) {
+            return;
+        }
+        String token = IntentUtils.safeGetStringExtra(incoming, EXTRA_IWA_LAUNCH_TOKEN);
+        if (token == null) return;
+        IwaLaunchReservation reservation = sPendingIwaLaunches.get(token);
+        if (reservation != null && reservation.handedOff && appId.equals(reservation.appId)) {
+            releaseIwaLaunch(token);
+        }
+    }
+
+    @Override
+    public void onNewIntent(Intent intent) {
+        super.onNewIntent(intent);
+        consumeIwaLaunch(this, intent);
+    }
+
