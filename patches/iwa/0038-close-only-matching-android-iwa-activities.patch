+    /** Requests closure; windows remain counted until Android reports them destroyed. */
+    @CalledByNative
+    static void closeIwaWindowsForApp(@JniType("std::string") String appId) {
+        ThreadUtils.assertOnUiThread();
+        for (Activity activity : ApplicationStatus.getRunningActivities()) {
+            if (!(activity instanceof WebappActivity)) continue;
+            Intent intent = activity.getIntent();
+            if (intent != null
+                    && appId.equals(
+                            IntentUtils.safeGetStringExtra(intent, IwaLauncherActivity.EXTRA_APP_ID))
+                    && !activity.isFinishing()) {
+                activity.finish();
+            }
+        }
+    }
+
