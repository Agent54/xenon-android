+    public void closeIwaWindowsOnlyFinishesMatchingActivities() {
+        String appId = "idgjjoiemckfcohgjoaafbninphmambh";
+        TestWebappActivity foreground = new TestWebappActivity();
+        foreground.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId));
+        TestWebappActivity background = new TestWebappActivity();
+        background.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId));
+        TestWebappActivity anotherIwa = new TestWebappActivity();
+        anotherIwa.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, "another-app"));
+        TestWebappActivity ordinaryWebapp = new TestWebappActivity();
+        ordinaryWebapp.setIntent(new Intent());
+        Activity markedNonWebapp = new Activity();
+        markedNonWebapp.setIntent(new Intent().putExtra(IwaLauncherActivity.EXTRA_APP_ID, appId));
+
+        try {
+            ApplicationStatus.onStateChangeForTesting(foreground, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(background, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(anotherIwa, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(ordinaryWebapp, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(markedNonWebapp, ActivityState.CREATED);
+            ApplicationStatus.onStateChangeForTesting(background, ActivityState.STOPPED);
+
+            WebappActivity.closeIwaWindowsForApp(appId);
+
+            assertTrue(foreground.isFinishing());
+            assertTrue(background.isFinishing());
+            assertFalse(anotherIwa.isFinishing());
+            assertFalse(ordinaryWebapp.isFinishing());
+            assertFalse(markedNonWebapp.isFinishing());
+            assertEquals(2, WebappActivity.getNumIwaWindowsForApp(appId));
+            WebappActivity.closeIwaWindowsForApp(appId);
+            assertEquals(2, WebappActivity.getNumIwaWindowsForApp(appId));
+        } finally {
+            ApplicationStatus.onStateChangeForTesting(foreground, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(background, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(anotherIwa, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(ordinaryWebapp, ActivityState.DESTROYED);
+            ApplicationStatus.onStateChangeForTesting(markedNonWebapp, ActivityState.DESTROYED);
+        }
+        assertEquals(0, WebappActivity.getNumIwaWindowsForApp(appId));
+    }
