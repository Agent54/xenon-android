+TEST(IsolatedWebAppUpdateCallbackCoordinatorTest,
+     DestructorRejectsRegistrationFromDiscardedCallback) {
+  base::test::TaskEnvironment task_environment;
+  int starts = 0;
+  int reentries = 0;
+  int errors = 0;
+  auto coordinator = std::make_unique<IsolatedWebAppUpdateCallbackCoordinator>(
+      base::BindRepeating([](const webapps::AppId&) { return true; }),
+      base::BindRepeating([](int* count, const webapps::AppId&) { ++*count; },
+                          &starts));
+
+  auto* owner = coordinator.get();
+  base::ScopedClosureRunner on_discard(base::BindOnce(
+      [](IsolatedWebAppUpdateCallbackCoordinator* owner, int* reentries,
+         int* errors) {
+        ++*reentries;
+        owner->PrioritizeAndWait(
+            "app",
+            base::BindOnce(
+                [](int* errors, IsolatedWebAppApplyUpdateCommandResult result) {
+                  EXPECT_FALSE(result.has_value());
+                  ++*errors;
+                },
+                errors));
+      },
+      owner, &reentries, &errors));
+  coordinator->PrioritizeAndWait(
+      "app",
+      base::BindOnce([](base::ScopedClosureRunner,
+                        IsolatedWebAppApplyUpdateCommandResult) { FAIL(); },
+                     std::move(on_discard)));
+  EXPECT_EQ(starts, 1);
+
+  coordinator.reset();
+  EXPECT_EQ(reentries, 1);
+  EXPECT_EQ(starts, 1);
+  task_environment.RunUntilIdle();
+  EXPECT_EQ(errors, 1);
+}
