@@ -0,0 +1,233 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/web_applications/android_iwa_close_waiter_bridge.h"
+
+#include <map>
+#include <memory>
+#include <string>
+#include <utility>
+#include <vector>
+
+#include "base/functional/bind.h"
+#include "testing/gtest/include/gtest/gtest.h"
+
+namespace web_app {
+namespace {
+
+constexpr char kAppId[] = "idgjjoiemckfcohgjoaafbninphmambh";
+
+TEST(AndroidIwaCloseWaiterBridgeTest, SynchronousCompletionCanDestroyOwner) {
+  std::unique_ptr<AndroidIwaCloseWaiterBridge> bridge;
+  int completions = 0;
+  int cancellations = 0;
+  bridge = std::make_unique<AndroidIwaCloseWaiterBridge>(
+      base::BindRepeating(
+          [](const webapps::AppId& app_id, const std::string& waiter_id,
+             base::OnceClosure completion) {
+            EXPECT_EQ(kAppId, app_id);
+            EXPECT_FALSE(waiter_id.empty());
+            std::move(completion).Run();
+          }),
+      base::BindRepeating(
+          [](int* cancellations, const std::string& waiter_id) {
+            ++*cancellations;
+          },
+          &cancellations));
+  bridge->Wait(kAppId, base::BindOnce(
+                           [](std::unique_ptr<AndroidIwaCloseWaiterBridge>* owner,
+                              int* completions) {
+                             ++*completions;
+                             owner->reset();
+                           },
+                           &bridge, &completions));
+  EXPECT_EQ(1, completions);
+  EXPECT_EQ(nullptr, bridge);
+  EXPECT_EQ(0, cancellations);
+}
+
+TEST(AndroidIwaCloseWaiterBridgeTest, ShutdownCancelsAndIgnoresLateCompletion) {
+  std::map<std::string, base::OnceClosure> registered;
+  std::vector<std::string> canceled;
+  int completions = 0;
+  auto bridge = std::make_unique<AndroidIwaCloseWaiterBridge>(
+      base::BindRepeating(
+          [](std::map<std::string, base::OnceClosure>* registered,
+             const webapps::AppId& app_id, const std::string& waiter_id,
+             base::OnceClosure completion) {
+            registered->emplace(waiter_id, std::move(completion));
+          },
+          &registered),
+      base::BindRepeating(
+          [](std::vector<std::string>* canceled,
+             const std::string& waiter_id) { canceled->push_back(waiter_id); },
+          &canceled));
+  bridge->Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  ASSERT_EQ(1u, registered.size());
+  std::string waiter_id = registered.begin()->first;
+  bridge->Shutdown();
+  bridge->Shutdown();
+  EXPECT_EQ(std::vector<std::string>{waiter_id}, canceled);
+  std::move(registered.at(waiter_id)).Run();
+  EXPECT_EQ(0, completions);
+  bridge.reset();
+  EXPECT_EQ(1u, canceled.size());
+}
+
+TEST(AndroidIwaCloseWaiterBridgeTest, MultipleWaitersCompleteIndependently) {
+  std::map<std::string, base::OnceClosure> registered;
+  std::vector<std::string> canceled;
+  int first = 0;
+  int second = 0;
+  AndroidIwaCloseWaiterBridge bridge(
+      base::BindRepeating(
+          [](std::map<std::string, base::OnceClosure>* registered,
+             const webapps::AppId& app_id, const std::string& waiter_id,
+             base::OnceClosure completion) {
+            registered->emplace(waiter_id, std::move(completion));
+          },
+          &registered),
+      base::BindRepeating(
+          [](std::vector<std::string>* canceled,
+             const std::string& waiter_id) { canceled->push_back(waiter_id); },
+          &canceled));
+  bridge.Wait(kAppId,
+              base::BindOnce([](int* count) { ++*count; }, &first));
+  bridge.Wait(kAppId,
+              base::BindOnce([](int* count) { ++*count; }, &second));
+  ASSERT_EQ(2u, registered.size());
+  auto it = registered.begin();
+  std::move(it->second).Run();
+  EXPECT_EQ(1, first + second);
+  bridge.Shutdown();
+  ASSERT_EQ(1u, canceled.size());
+  EXPECT_NE(it->first, canceled.front());
+  EXPECT_EQ(1, first + second);
+}
+
+TEST(AndroidIwaCloseWaiterBridgeTest,
+     ReentrantCancellationCanDestroyOwnerWithPendingWaiters) {
+  std::map<std::string, base::OnceClosure> registered;
+  std::vector<std::string> canceled;
+  int completions = 0;
+  std::unique_ptr<AndroidIwaCloseWaiterBridge> bridge;
+  bridge = std::make_unique<AndroidIwaCloseWaiterBridge>(
+      base::BindRepeating(
+          [](std::map<std::string, base::OnceClosure>* registered,
+             const webapps::AppId& app_id, const std::string& waiter_id,
+             base::OnceClosure completion) {
+            registered->emplace(waiter_id, std::move(completion));
+          },
+          &registered),
+      base::BindRepeating(
+          [](std::unique_ptr<AndroidIwaCloseWaiterBridge>* owner,
+             std::vector<std::string>* canceled,
+             const std::string& waiter_id) {
+            canceled->push_back(waiter_id);
+            owner->reset();
+          },
+          &bridge, &canceled));
+  bridge->Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  bridge->Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  ASSERT_EQ(2u, registered.size());
+  bridge->Shutdown();
+  EXPECT_EQ(nullptr, bridge);
+  EXPECT_EQ(2u, canceled.size());
+  for (auto& [waiter_id, completion] : registered) {
+    std::move(completion).Run();
+  }
+  EXPECT_EQ(0, completions);
+}
+
+TEST(AndroidIwaCloseWaiterBridgeTest, WaitAfterShutdownDoesNotRegister) {
+  int registrations = 0;
+  int completions = 0;
+  AndroidIwaCloseWaiterBridge bridge(
+      base::BindRepeating(
+          [](int* registrations, const webapps::AppId& app_id,
+             const std::string& waiter_id, base::OnceClosure completion) {
+            ++*registrations;
+          },
+          &registrations),
+      base::BindRepeating([](const std::string& waiter_id) {}));
+  bridge.Shutdown();
+  bridge.Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  EXPECT_EQ(0, registrations);
+  EXPECT_EQ(0, completions);
+}
+
+TEST(AndroidIwaCloseWaiterBridgeTest,
+     DestructorCancelsEveryPendingWaiterAndInvalidatesCompletions) {
+  std::map<std::string, base::OnceClosure> registered;
+  std::vector<std::string> canceled;
+  int completions = 0;
+  auto bridge = std::make_unique<AndroidIwaCloseWaiterBridge>(
+      base::BindRepeating(
+          [](std::map<std::string, base::OnceClosure>* registered,
+             const webapps::AppId& app_id, const std::string& waiter_id,
+             base::OnceClosure completion) {
+            registered->emplace(waiter_id, std::move(completion));
+          },
+          &registered),
+      base::BindRepeating(
+          [](std::vector<std::string>* canceled,
+             const std::string& waiter_id) { canceled->push_back(waiter_id); },
+          &canceled));
+  bridge->Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  bridge->Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  ASSERT_EQ(2u, registered.size());
+  bridge.reset();
+  ASSERT_EQ(2u, canceled.size());
+  EXPECT_NE(canceled[0], canceled[1]);
+  for (auto& [waiter_id, completion] : registered) {
+    std::move(completion).Run();
+  }
+  EXPECT_EQ(0, completions);
+}
+
+TEST(AndroidIwaCloseWaiterBridgeTest,
+     ReentrantCancellationCannotRegisterAnotherWaiter) {
+  std::map<std::string, base::OnceClosure> registered;
+  std::vector<std::string> canceled;
+  int completions = 0;
+  AndroidIwaCloseWaiterBridge* bridge_ptr = nullptr;
+  AndroidIwaCloseWaiterBridge bridge(
+      base::BindRepeating(
+          [](std::map<std::string, base::OnceClosure>* registered,
+             const webapps::AppId& app_id, const std::string& waiter_id,
+             base::OnceClosure completion) {
+            registered->emplace(waiter_id, std::move(completion));
+          },
+          &registered),
+      base::BindRepeating(
+          [](AndroidIwaCloseWaiterBridge** owner,
+             std::vector<std::string>* canceled, int* completions,
+             const std::string& waiter_id) {
+            canceled->push_back(waiter_id);
+            (*owner)->Shutdown();
+            (*owner)->Wait(
+                kAppId,
+                base::BindOnce([](int* count) { ++*count; }, completions));
+          },
+          &bridge_ptr, &canceled, &completions));
+  bridge_ptr = &bridge;
+  bridge.Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  bridge.Wait(kAppId, base::BindOnce([](int* count) { ++*count; },
+                                      &completions));
+  ASSERT_EQ(2u, registered.size());
+  bridge.Shutdown();
+  EXPECT_EQ(2u, canceled.size());
+  EXPECT_EQ(2u, registered.size());
+  EXPECT_EQ(0, completions);
+}
+
+}  // namespace
+}  // namespace web_app
