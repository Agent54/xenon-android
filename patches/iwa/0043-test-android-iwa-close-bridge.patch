@@ -0,0 +1,69 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/web_applications/android_iwa_close_waiter_bridge.h"
+
+#include <utility>
+
+#include "base/functional/bind.h"
+#include "base/uuid.h"
+
+namespace web_app {
+
+AndroidIwaCloseWaiterBridge::AndroidIwaCloseWaiterBridge(
+    RegisterCallback register_callback,
+    CancelCallback cancel_callback)
+    : register_callback_(std::move(register_callback)),
+      cancel_callback_(std::move(cancel_callback)) {}
+
+AndroidIwaCloseWaiterBridge::~AndroidIwaCloseWaiterBridge() {
+  Shutdown();
+}
+
+void AndroidIwaCloseWaiterBridge::Wait(const webapps::AppId& app_id,
+                                       base::OnceClosure callback) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_) {
+    return;
+  }
+  std::string waiter_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  while (pending_callbacks_.contains(waiter_id)) {
+    waiter_id = base::Uuid::GenerateRandomV4().AsLowercaseString();
+  }
+  pending_callbacks_.emplace(waiter_id, std::move(callback));
+  auto completion = base::BindOnce(&AndroidIwaCloseWaiterBridge::OnCompleted,
+                                   weak_factory_.GetWeakPtr(), waiter_id);
+  RegisterCallback register_callback = register_callback_;
+  // Completion can destroy this bridge. This must remain the final operation.
+  register_callback.Run(app_id, waiter_id, std::move(completion));
+}
+
+void AndroidIwaCloseWaiterBridge::Shutdown() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (shutdown_) {
+    return;
+  }
+  shutdown_ = true;
+  weak_factory_.InvalidateWeakPtrs();
+  auto callbacks = std::move(pending_callbacks_);
+  pending_callbacks_.clear();
+  CancelCallback cancel_callback = cancel_callback_;
+  for (const auto& [waiter_id, callback] : callbacks) {
+    cancel_callback.Run(waiter_id);
+  }
+}
+
+void AndroidIwaCloseWaiterBridge::OnCompleted(
+    const std::string& waiter_id) {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  auto it = pending_callbacks_.find(waiter_id);
+  if (it == pending_callbacks_.end()) {
+    return;
+  }
+  base::OnceClosure callback = std::move(it->second);
+  pending_callbacks_.erase(it);
+  std::move(callback).Run();
+}
+
+}  // namespace web_app
