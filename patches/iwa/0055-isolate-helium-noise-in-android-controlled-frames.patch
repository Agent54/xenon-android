+#include "content/public/browser/storage_partition_config.h"
+#include "testing/gtest/include/gtest/gtest.h"
+#include "url/gurl.h"
+#include "url/origin.h"
+#include "url/url_util.h"
+
+namespace content {
+StoragePartitionConfig CreateStoragePartitionConfigForTesting(
+    bool in_memory,
+    const std::string& partition_domain,
+    const std::string& partition_name) {
+  return StoragePartitionConfig(partition_domain, partition_name, in_memory);
+}
+}  // namespace content
+
+namespace controlled_frame {
+namespace {
+
+web_app::IwaOrigin GetIwaOrigin(const char* host) {
+  return web_app::IwaOrigin(
+      web_package::SignedWebBundleId::Create(host).value());
+}
+
+class ControlledFrameNoiseScopeTest : public testing::Test {
+ public:
+  void SetUp() override {
+    url::AddStandardScheme(webapps::kIsolatedAppScheme,
+                           url::SCHEME_WITH_HOST);
+  }
+
+ private:
+  url::ScopedSchemeRegistryForTests scoped_scheme_registry_;
+};
+
+TEST_F(ControlledFrameNoiseScopeTest, RequiresOwningIwaPartition) {
+  const web_app::IwaOrigin owner = GetIwaOrigin(
+      "b7looprugym3zyxqffzqdz4mzc2vz4j6ge3arxg2ybbzwgb6ne2qaaic");
+  const web_app::IwaOrigin other = GetIwaOrigin(
+      "c6mopl2f4c2y7oha7vlvgjvtcwwvvvuk6odzcnojijcfpzyaa2oaaaic");
+  const auto parsed_owner = web_app::IwaOrigin::Create(owner.origin().GetURL());
+  ASSERT_TRUE(parsed_owner) << parsed_owner.error();
+  const auto guest_x = content::CreateStoragePartitionConfigForTesting(
+      false, owner.GetPartitionDomain(), "x");
+  const auto guest_y = content::CreateStoragePartitionConfigForTesting(
+      false, owner.GetPartitionDomain(), "y");
+  const auto guest_x_memory = content::CreateStoragePartitionConfigForTesting(
+      true, owner.GetPartitionDomain(), "x");
+  const auto unnamed_memory = content::CreateStoragePartitionConfigForTesting(
+      true, owner.GetPartitionDomain(), "");
+  auto guest_x_with_fallback = guest_x;
+  guest_x_with_fallback.set_fallback_to_partition_domain_for_blob_urls(
+      content::StoragePartitionConfig::FallbackMode::
+          kFallbackPartitionOnDisk);
+  const auto other_guest = content::CreateStoragePartitionConfigForTesting(
+      false, other.GetPartitionDomain(), "x");
+  const auto base_app = content::CreateStoragePartitionConfigForTesting(
+      false, owner.GetPartitionDomain(), "");
+  const auto default_partition =
+      content::CreateStoragePartitionConfigForTesting(false, "", "");
+
+  const auto scope_x =
+      GetIwaControlledFrameNoiseScope(owner.origin(), guest_x);
+  ASSERT_TRUE(scope_x);
+  EXPECT_EQ(scope_x, GetIwaControlledFrameNoiseScope(owner.origin(), guest_x));
+  EXPECT_NE(scope_x, GetIwaControlledFrameNoiseScope(owner.origin(), guest_y));
+  EXPECT_NE(scope_x,
+            GetIwaControlledFrameNoiseScope(owner.origin(), guest_x_memory));
+  EXPECT_NE(scope_x, GetIwaControlledFrameNoiseScope(
+                         owner.origin(), guest_x_with_fallback));
+  EXPECT_TRUE(
+      GetIwaControlledFrameNoiseScope(owner.origin(), unnamed_memory));
+  EXPECT_FALSE(GetIwaControlledFrameNoiseScope(owner.origin(), other_guest));
+  EXPECT_FALSE(GetIwaControlledFrameNoiseScope(owner.origin(), base_app));
+  EXPECT_FALSE(
+      GetIwaControlledFrameNoiseScope(owner.origin(), default_partition));
+  EXPECT_FALSE(GetIwaControlledFrameNoiseScope(
+      url::Origin::Create(GURL("https://example.test/")), guest_x));
+  const auto other_scope =
+      GetIwaControlledFrameNoiseScope(other.origin(), other_guest);
+  EXPECT_TRUE(other_scope);
+  EXPECT_NE(scope_x, other_scope);
+}
+
+}  // namespace
+}  // namespace controlled_frame
