+class NoiseTokenHost : public base::SupportsUserData {
+ public:
+  ~NoiseTokenHost() override = default;
+};
+
+TEST(HeliumNoiseTokenDataTest, SameOriginGuestPartitionsHaveDistinctTokens) {
+  NoiseTokenHost host;
+  const url::Origin origin =
+      url::Origin::Create(GURL("https://example.test/"));
+
+  const auto ordinary = HeliumNoiseTokenData::GetTokens(&host, origin);
+  const auto guest_a = HeliumNoiseTokenData::GetTokens(
+      &host, origin, "iwa-one/persistent/partition-a");
+  const auto guest_a_repeat = HeliumNoiseTokenData::GetTokens(
+      &host, origin, "iwa-one/persistent/partition-a");
+  const auto guest_b = HeliumNoiseTokenData::GetTokens(
+      &host, origin, "iwa-one/persistent/partition-b");
+  const auto other_iwa = HeliumNoiseTokenData::GetTokens(
+      &host, origin, "iwa-two/persistent/partition-a");
+
+  EXPECT_EQ(guest_a, guest_a_repeat);
+  EXPECT_FALSE(ordinary == guest_a);
+  EXPECT_FALSE(guest_a == guest_b);
+  EXPECT_FALSE(guest_a == other_iwa);
+}
+
+}  // namespace
+}  // namespace content
