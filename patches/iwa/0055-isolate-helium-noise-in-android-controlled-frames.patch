@@ -0,0 +1,44 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/controlled_frame/controlled_frame_noise_scope.h"
+
+#include <string>
+#include <string_view>
+
+#include "components/webapps/isolated_web_apps/types/iwa_origin.h"
+#include "content/public/browser/storage_partition_config.h"
+#include "url/origin.h"
+
+namespace controlled_frame {
+
+std::optional<std::string> GetIwaControlledFrameNoiseScope(
+    const url::Origin& embedder_origin,
+    const content::StoragePartitionConfig& guest_partition) {
+  const auto owner = web_app::IwaOrigin::Create(embedder_origin.GetURL());
+  if (!owner || guest_partition.is_default() ||
+      guest_partition.partition_domain() != owner->GetPartitionDomain() ||
+      (guest_partition.partition_name().empty() &&
+       !guest_partition.in_memory())) {
+    return std::nullopt;
+  }
+
+  // Length-prefix strings so a partition name cannot collide with another
+  // owner, name, or persistence mode when the scope is hashed.
+  std::string scope;
+  auto append_field = [&scope](std::string_view value) {
+    scope.append(std::to_string(value.size()));
+    scope.push_back(':');
+    scope.append(value);
+  };
+  append_field(embedder_origin.Serialize());
+  append_field(guest_partition.partition_domain());
+  append_field(guest_partition.partition_name());
+  append_field(guest_partition.in_memory() ? "memory" : "persistent");
+  append_field(std::to_string(static_cast<int>(
+      guest_partition.fallback_to_partition_domain_for_blob_urls())));
+  return scope;
+}
+
+}  // namespace controlled_frame
