diff --git a/chrome/browser/web_applications/android_iwa_update_lease_jni.cc b/chrome/browser/web_applications/android_iwa_update_lease_jni.cc
new file mode 100644
index 0000000..6b6ab90
--- /dev/null
+++ b/chrome/browser/web_applications/android_iwa_update_lease_jni.cc
@@ -0,0 +1,43 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/web_applications/android_iwa_update_lease_jni.h"
+
+#include <memory>
+#include <string>
+
+#include "base/android/jni_android.h"
+#include "base/android/jni_string.h"
+#include "base/functional/bind.h"
+#include "content/public/browser/browser_thread.h"
+
+// Must come after headers that specialize FromJniType() / ToJniType().
+#include "chrome/android/chrome_jni_headers/WebappActivity_jni.h"
+
+namespace web_app {
+namespace {
+
+std::string AcquireFromJava(const webapps::AppId& app_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return Java_WebappActivity_tryAcquireIwaUpdateLeaseForNative(
+      base::android::AttachCurrentThread(), app_id);
+}
+
+void ReleaseToJava(const webapps::AppId& app_id, const std::string& token) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  Java_WebappActivity_releaseIwaUpdateLeaseForNative(
+      base::android::AttachCurrentThread(), app_id, token);
+}
+
+}  // namespace
+
+std::unique_ptr<AndroidIwaUpdateLease> TryAcquireAndroidIwaUpdateLeaseFromJava(
+    const webapps::AppId& app_id) {
+  DCHECK_CURRENTLY_ON(content::BrowserThread::UI);
+  return AndroidIwaUpdateLease::TryAcquire(
+      app_id, base::BindRepeating(&AcquireFromJava),
+      base::BindRepeating(&ReleaseToJava));
+}
+
+}  // namespace web_app
