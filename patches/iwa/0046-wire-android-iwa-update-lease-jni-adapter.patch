+#ifndef CHROME_BROWSER_WEB_APPLICATIONS_ANDROID_IWA_UPDATE_LEASE_JNI_H_
+#define CHROME_BROWSER_WEB_APPLICATIONS_ANDROID_IWA_UPDATE_LEASE_JNI_H_
+
+#include <memory>
+
+#include "chrome/browser/web_applications/android_iwa_update_lease.h"
+#include "components/webapps/common/web_app_id.h"
+
+namespace web_app {
+
+// Acquires the Android activity tracker's lease on the browser UI thread.
+// Returns null when the app has a pending launch, recreation, live activity,
+// or another update owner. The caller owns release through the returned RAII
+// object on the browser UI thread; update commands must not outlive this owner.
+std::unique_ptr<AndroidIwaUpdateLease> TryAcquireAndroidIwaUpdateLeaseFromJava(
+    const webapps::AppId& app_id);
+
+}  // namespace web_app
+
+#endif  // CHROME_BROWSER_WEB_APPLICATIONS_ANDROID_IWA_UPDATE_LEASE_JNI_H_
