@@ -0,0 +1,49 @@
+// Copyright 2026 The Chromium Authors
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "chrome/browser/web_applications/android_iwa_update_lease.h"
+
+#include <memory>
+#include <string>
+#include <utility>
+
+namespace web_app {
+
+// static
+std::unique_ptr<AndroidIwaUpdateLease> AndroidIwaUpdateLease::TryAcquire(
+    webapps::AppId app_id,
+    AcquireCallback acquire_callback,
+    ReleaseCallback release_callback) {
+  std::string token = acquire_callback.Run(app_id);
+  if (token.empty()) {
+    return nullptr;
+  }
+  return std::unique_ptr<AndroidIwaUpdateLease>(new AndroidIwaUpdateLease(
+      std::move(app_id), std::move(token), std::move(release_callback)));
+}
+
+AndroidIwaUpdateLease::AndroidIwaUpdateLease(webapps::AppId app_id,
+                                             std::string token,
+                                             ReleaseCallback release_callback)
+    : app_id_(std::move(app_id)),
+      token_(std::move(token)),
+      release_callback_(std::move(release_callback)) {}
+
+AndroidIwaUpdateLease::~AndroidIwaUpdateLease() {
+  Release();
+}
+
+void AndroidIwaUpdateLease::Release() {
+  DCHECK_CALLED_ON_VALID_SEQUENCE(sequence_checker_);
+  if (token_.empty()) {
+    return;
+  }
+  std::string token = std::exchange(token_, {});
+  webapps::AppId app_id = app_id_;
+  ReleaseCallback release_callback = release_callback_;
+  // The callback may destroy this object. Do not touch members afterwards.
+  release_callback.Run(app_id, token);
+}
+
+}  // namespace web_app
