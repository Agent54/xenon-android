+    const std::string& partition_name,
+    bool in_memory,
+    base::OnceCallback<void(std::optional<content::StoragePartitionConfig>)>
+        callback) {
+  if (owner_site_instance->GetSecurityPrincipal().SchemeIs(
+          webapps::kIsolatedAppScheme)) {
+    auto url_info = web_app::IsolatedWebAppUrlInfo::CreateFromHost(
+        owner_site_instance->GetSecurityPrincipal().GetHost());
+    auto* provider = web_app::WebAppProvider::GetForWebApps(
+        Profile::FromBrowserContext(browser_context));
+    if (!url_info.has_value() || !provider) {
+      std::move(callback).Run(std::nullopt);
+      return;
+    }
+    provider->scheduler().GetControlledFramePartition(
+        *url_info, partition_name, in_memory, std::move(callback));
+    return;
+  }
+
+  ExtensionsBrowserClient::GetWebViewStoragePartitionConfig(
+      browser_context, owner_site_instance, partition_name, in_memory,
+      std::move(callback));
