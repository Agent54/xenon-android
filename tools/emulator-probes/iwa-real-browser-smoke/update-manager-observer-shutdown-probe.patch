+// Disposable emulator-only observer. It removes itself before shutdown so a
+// CheckedObserver never outlives the manager's observer list.
+class XenonShutdownOnApplyObserver final
+    : public IsolatedWebAppUpdateManager::Observer {
+ public:
+  explicit XenonShutdownOnApplyObserver(IsolatedWebAppUpdateManager& manager)
+      : manager_(manager) {}
+
+  void OnUpdateApplyTaskCompleted(
