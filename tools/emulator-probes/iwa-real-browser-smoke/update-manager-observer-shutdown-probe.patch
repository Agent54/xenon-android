+      IsolatedWebAppApplyUpdateCommandResult) override {
+    manager_.RemoveObserver(this);
+    LOG(ERROR) << "XENON_IWA_MANAGER_OBSERVER_SHUTDOWN";
+    manager_.Shutdown();
+  }
+
+ private:
+  IsolatedWebAppUpdateManager& manager_;
+};
+#endif
