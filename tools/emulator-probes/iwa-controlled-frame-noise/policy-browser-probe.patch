+#if BUILDFLAG(IS_DESKTOP_ANDROID)
+  // Disposable emulator-only browser policy probe. Never ship this switch.
+  const std::string mode = base::CommandLine::ForCurrentProcess()
+                               ->GetSwitchValueASCII("xenon-test-helium-noise-policy");
+  if (!mode.empty() && origin.SchemeIs("https") &&
