+                             : helium_noise::IsHeliumNoiseEnabled(browser_context,
+                                                                   origin);
+    LOG(ERROR) << "XENON_NOISE_POLICY mode=" << mode
+               << " guest=" << is_iwa_controlled_frame_guest
+               << " enabled=" << enabled;
+    return enabled;
+  }
+#endif
